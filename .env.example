# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Fish Audio API key from https://fish.audio Account → API
FISH_AUDIO_API_KEY=

# Fish Audio reference_id for the voice you want to use
FISH_VOICE_ID=

# Comma-separated Discord guild IDs the bot is allowed to operate in
ALLOWED_GUILDS=

# Discord user ID of the bot owner (only user who can manage the whitelist).
# Right-click your username in Discord (with Developer Mode on) → Copy User ID
BOT_OWNER=

# Optional
FISH_MODEL=s2-pro
FISH_LATENCY=low
MAX_TEXT_LEN=200
QUEUE_MAXSIZE=20
LOG_LEVEL=INFO

# Path to the JSON-backed user whitelist (relative or absolute)
WHITELIST_PATH=data/whitelist.json
