# --- Required (secrets only) ---

# Discord bot token from https://discord.com/developers/applications → Bot tab
DISCORD_TOKEN=

# Fish Audio API key from https://fish.audio Account → API
FISH_AUDIO_API_KEY=


# --- Optional ---

# Where runtime config is persisted (whitelist, voice_id, etc.). Default: data/
# DATA_DIR=data

# Logging verbosity
# LOG_LEVEL=INFO

# Fish Audio model. s2.1-pro-free costs nothing (fair use, promised through
# Nov 30 2026); switch to s2.1-pro and add API credit if it ends.
# FISH_MODEL=s2.1-pro-free
# FISH_LATENCY=low

# Per-message text length limit (shortcuts may expand a message to 2x this)
# MAX_TEXT_LEN=200

# Auto-leave voice if alone in the channel for this many minutes (0 disables).
# IDLE_TIMEOUT_MINUTES=5

# Voice of the SERVER pseudo-user (/announce, alerts). Only seeds the config the
# first time; change it later with /voice server.
# SERVER_VOICE_ID=76bb6ae7b26c41fbbd484514fdb014c2

# Monthly TTS budget behind the bot status "Usage: N% remaining" on free models
# (UTF-8 bytes; 1,000,000 ~= 12 h of speech ~= $15 at paid rates).
# USAGE_BUDGET_BYTES=1000000

# Paid models: DM + SERVER announcement when Fish API credit drops below this.
# FISH_CREDIT_ALERT_USD=1.0


# --- Owner / voice / whitelist are configured at runtime, NOT here ---
#
# After first start, the bot will DM the Discord-app owner with setup
# instructions. Use:
#   /voice default <link or id>     to set the default voice
#   /voice set <link or id>         each user picks their own voice
#   /whitelist add @user            to grant access
#   /help                           to see all commands
