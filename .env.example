# --- Required (secrets only) ---

# Discord bot token from https://discord.com/developers/applications → Bot tab
DISCORD_TOKEN=

# Fish Audio API key from https://fish.audio Account → API
FISH_AUDIO_API_KEY=


# --- Optional ---

# Where runtime config is persisted (whitelist, voice_id, etc.). Default: data/
# DATA_DIR=data

# Logging verbosity
# LOG_LEVEL=INFO

# Fish Audio defaults (rarely changed)
# FISH_MODEL=s2-pro
# FISH_LATENCY=low

# Per-message text length limit
# MAX_TEXT_LEN=200


# --- Owner / voice / whitelist are configured at runtime, NOT here ---
#
# After first start, the bot will DM the Discord-app owner with setup
# instructions. Use:
#   /voice set <fish_voice_id>      to set the global voice
#   /whitelist add @user            to grant access
#   /help                           to see all commands
